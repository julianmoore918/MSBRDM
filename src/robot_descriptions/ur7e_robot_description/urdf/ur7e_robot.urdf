<?xml version="1.0" encoding="UTF-8"?>
<robot name="ur7e_robot">
<!-- UR7e description, values from the official Universal_Robots_ROS2_Description config/ur7e files -->
<!-- Meshes (c) 2023 Universal Robots A/S, use subject to meshes/TERMS_AND_CONDITIONS.txt -->

  <link name="world"/>

  <joint name="base_link_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <!-- Robot base placed at the world origin -->
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link"/>

  <joint name="base_link_inertia_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_link_inertia"/>
    <!-- UR convention, base_link (REP 103) is turned 180 deg against the UR base frame -->
    <origin xyz="0 0 0" rpy="0 0 3.14159265359"/>
  </joint>

  <link name="base_link_inertia">
    <visual>
      <geometry>
        <mesh filename="package://ur7e_robot_description/meshes/visual/base.dae"/>
      </geometry>
      <!-- Mesh offset from visual_parameters.yaml, yaw 180 deg -->
      <origin xyz="0 0 0" rpy="0 0 3.14159265359"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://ur7e_robot_description/meshes/collision/base.stl"/>
      </geometry>
      <!-- Mesh offset from visual_parameters.yaml, yaw 180 deg -->
      <origin xyz="0 0 0" rpy="0 0 3.14159265359"/>
    </collision>
  </link>

  <joint name="shoulder_pan_joint" type="revolute">
    <axis xyz="0 0 1"/>
    <!-- One full turn, plus and minus 180 deg, 150 Nm and 180 deg per s from joint_limits.yaml -->
    <limit effort="150" velocity="3.14159265359" lower="-3.14159265359" upper="3.14159265359"/>
    <parent link="base_link_inertia"/>
    <child link="shoulder_link"/>
    <!-- DH d1 = 0.1625 m above the base -->
    <origin xyz="0 0 0.1625" rpy="0 0 0"/>
  </joint>

  <link name="shoulder_link">
    <visual>
      <geometry>
        <mesh filename="package://ur7e_robot_description/meshes/visual/shoulder.dae"/>
      </geometry>
      <!-- Mesh offset from visual_parameters.yaml, yaw 180 deg -->
      <origin xyz="0 0 0" rpy="0 0 3.14159265359"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://ur7e_robot_description/meshes/collision/shoulder.stl"/>
      </geometry>
      <!-- Mesh offset from visual_parameters.yaml, yaw 180 deg -->
      <origin xyz="0 0 0" rpy="0 0 3.14159265359"/>
    </collision>
  </link>

  <joint name="shoulder_lift_joint" type="revolute">
    <axis xyz="0 0 1"/>
    <!-- Half a turn from horizontal through upright to horizontal, so the arm stays above the base plane -->
    <limit effort="150" velocity="3.14159265359" lower="-3.14159265359" upper="0.0"/>
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <!-- Same point as the shoulder, axis turned 90 deg about x (DH alpha1) -->
    <origin xyz="0 0 0" rpy="1.570796327 0 0"/>
  </joint>

  <link name="upper_arm_link">
    <visual>
      <geometry>
        <mesh filename="package://ur7e_robot_description/meshes/visual/upperarm.dae"/>
      </geometry>
      <!-- Mesh offset from visual_parameters.yaml, 0.138 m along z, roll 90 deg and yaw minus 90 deg -->
      <origin xyz="0 0 0.138" rpy="1.570796327 0 -1.570796327"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://ur7e_robot_description/meshes/collision/upperarm.stl"/>
      </geometry>
      <!-- Mesh offset from visual_parameters.yaml, 0.138 m along z, roll 90 deg and yaw minus 90 deg -->
      <origin xyz="0 0 0.138" rpy="1.570796327 0 -1.570796327"/>
    </collision>
  </link>

  <joint name="elbow_joint" type="revolute">
    <axis xyz="0 0 1"/>
    <!-- Plus and minus 160 deg, beyond about 162 deg the forearm hits the upper arm (checked with the collision meshes) -->
    <limit effort="150" velocity="3.14159265359" lower="-2.8" upper="2.8"/>
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <!-- Upper arm length, DH a2 = 0.425 m -->
    <origin xyz="-0.425 0 0" rpy="0 0 0"/>
  </joint>

  <link name="forearm_link">
    <visual>
      <geometry>
        <mesh filename="package://ur7e_robot_description/meshes/visual/forearm.dae"/>
      </geometry>
      <!-- Mesh offset from visual_parameters.yaml, 0.007 m along z, roll 90 deg and yaw minus 90 deg -->
      <origin xyz="0 0 0.007" rpy="1.570796327 0 -1.570796327"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://ur7e_robot_description/meshes/collision/forearm.stl"/>
      </geometry>
      <!-- Mesh offset from visual_parameters.yaml, 0.007 m along z, roll 90 deg and yaw minus 90 deg -->
      <origin xyz="0 0 0.007" rpy="1.570796327 0 -1.570796327"/>
    </collision>
  </link>

  <joint name="wrist_1_joint" type="revolute">
    <axis xyz="0 0 1"/>
    <!-- One full turn, plus and minus 180 deg, 28 Nm and 180 deg per s from joint_limits.yaml -->
    <limit effort="28" velocity="3.14159265359" lower="-3.14159265359" upper="3.14159265359"/>
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <!-- Forearm length, DH a3 = 0.3922 m, and shoulder offset d4 = 0.1333 m -->
    <origin xyz="-0.3922 0 0.1333" rpy="0 0 0"/>
  </joint>

  <link name="wrist_1_link">
    <visual>
      <geometry>
        <mesh filename="package://ur7e_robot_description/meshes/visual/wrist1.dae"/>
      </geometry>
      <!-- Mesh offset from visual_parameters.yaml, minus 0.127 m along z and roll 90 deg -->
      <origin xyz="0 0 -0.127" rpy="1.570796327 0 0"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://ur7e_robot_description/meshes/collision/wrist1.stl"/>
      </geometry>
      <!-- Mesh offset from visual_parameters.yaml, minus 0.127 m along z and roll 90 deg -->
      <origin xyz="0 0 -0.127" rpy="1.570796327 0 0"/>
    </collision>
  </link>

  <joint name="wrist_2_joint" type="revolute">
    <axis xyz="0 0 1"/>
    <!-- One full turn, plus and minus 180 deg, 28 Nm and 180 deg per s from joint_limits.yaml -->
    <limit effort="28" velocity="3.14159265359" lower="-3.14159265359" upper="3.14159265359"/>
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <!-- DH d5 = 0.0997 m, axis turned 90 deg about x (DH alpha4) -->
    <origin xyz="0 -0.0997 0" rpy="1.570796327 0 0"/>
  </joint>

  <link name="wrist_2_link">
    <visual>
      <geometry>
        <mesh filename="package://ur7e_robot_description/meshes/visual/wrist2.dae"/>
      </geometry>
      <!-- Mesh offset from visual_parameters.yaml, minus 0.0997 m along z -->
      <origin xyz="0 0 -0.0997" rpy="0 0 0"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://ur7e_robot_description/meshes/collision/wrist2.stl"/>
      </geometry>
      <!-- Mesh offset from visual_parameters.yaml, minus 0.0997 m along z -->
      <origin xyz="0 0 -0.0997" rpy="0 0 0"/>
    </collision>
  </link>

  <joint name="wrist_3_joint" type="revolute">
    <axis xyz="0 0 1"/>
    <!-- One full turn, plus and minus 180 deg, 28 Nm and 180 deg per s from joint_limits.yaml -->
    <limit effort="28" velocity="3.14159265359" lower="-3.14159265359" upper="3.14159265359"/>
    <parent link="wrist_2_link"/>
    <child link="wrist_3_link"/>
    <!-- DH d6 = 0.0996 m, axis turned by alpha5 as in default_kinematics.yaml -->
    <origin xyz="0 0.0996 0" rpy="1.570796327 3.14159265359 3.14159265359"/>
  </joint>

  <link name="wrist_3_link">
    <visual>
      <geometry>
        <mesh filename="package://ur7e_robot_description/meshes/visual/wrist3.dae"/>
      </geometry>
      <!-- Mesh offset from visual_parameters.yaml, minus 0.0989 m along z and roll 90 deg -->
      <origin xyz="0 -0.0005 -0.0989" rpy="1.570796327 0 0"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://ur7e_robot_description/meshes/collision/wrist3.stl"/>
      </geometry>
      <!-- Mesh offset from visual_parameters.yaml, minus 0.0989 m along z and roll 90 deg -->
      <origin xyz="0 -0.0005 -0.0989" rpy="1.570796327 0 0"/>
    </collision>
  </link>

  <joint name="flange_joint" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="flange"/>
    <!-- ROS Industrial flange frame, x pointing out of the tool flange -->
    <origin xyz="0 0 0" rpy="0 -1.570796327 -1.570796327"/>
  </joint>

  <link name="flange"/>

  <joint name="tool0_joint" type="fixed">
    <parent link="flange"/>
    <child link="tool0"/>
    <!-- Tool frame as on the UR controller, z pointing out of the flange -->
    <origin xyz="0 0 0" rpy="1.570796327 0 1.570796327"/>
  </joint>

  <link name="tool0"/>

</robot>
